      "third_party/mutable/marbles/ramp/ramp_extractor.cc"
    ],
    "cflags": [
      "-Isrc",
      "-Isrc/shim",
      "-Ithird_party/valley/src",
      "-Ithird_party/rack/include",
      "-Ithird_party/simde",
      "-Ithird_party/bogaudio",
      "-Ithird_party/bogaudio/dsp",
      "-Ithird_party/bogaudio/lib",
      "-Ithird_party/mutable"
    ],
    "libs": [
      "-lm",
      "-ldl",
      "-lpthread"
    ]
  },
  "layout": "layout.conf",
  "title_font": "art/fonts/TitilliumWeb-SemiBold.ttf",
  "defines": {
    "HAS_DISPLAY_REV": 1,
    "SAMPLE_ACCURATE": 1,
    "HAS_LFO_BPM": 1,
