      "third_party/bogaudio/dsp/math.cpp",
      "third_party/bogaudio/dsp/noise.cpp",
      "third_party/bogaudio/dsp/oscillator.cpp",
      "third_party/bogaudio/dsp/signal.cpp",
      "third_party/bogaudio/dsp/table.cpp",
      "third_party/bogaudio/dsp/filters/filter.cpp",
      "third_party/mutable/stmlib/dsp/units.cc",
